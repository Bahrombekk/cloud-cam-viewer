# Address the devices can reach this host on (public IP or LAN IP).
PUBLIC_IP=
# Fallback Encryption Key (8-32 letters/digits) for devices without their own key.
# Leave empty if every device gets its key through `cloudcam isup keys`.
ISUP_KEY=
# Optional shared secret for the control API; set the same value as isup_token in cloudcam.
API_TOKEN=
# 0 = compatible (any protocol version), 2 = secure (ISUP 4.0+ only). Use 2 once your
# devices are known to work with it.
ACCESS_SECURITY=0
